# Telegram API credentials from my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash

# Bot that is already in the IDFLIX Telegram Group
TELEGRAM_BOT_TOKEN=123456:your_bot_token

# IDFLIX Telegram Group / supergroup chat ID
TELEGRAM_CHAT_ID=-1001234567890

# Optional helper bot tokens, comma-separated
TELEGRAM_HELPER_BOT_TOKENS=

# Temporary protection for direct testing. Leave empty only if you intentionally want public streaming.
STREAM_TOKEN=change-this

TELEGRAM_CLIENT_CONCURRENCY=3
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Comma-separated frontend origins, or * for initial testing
CORS_ORIGINS=*
